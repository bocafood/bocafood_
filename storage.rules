rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsTenant(tenantId) {
      return signedIn() && request.auth.uid == tenantId;
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tenants/{tenantId}/products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(tenantId) && validImage();
    }

    match /tenants/{tenantId}/banners/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(tenantId) && validImage();
    }

    match /tenants/{tenantId}/logos/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(tenantId) && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
